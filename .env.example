SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AFTERIMAGE_ACCESS_KEY=
AFTERIMAGE_WORKER_TOKEN=
# For the macserver storage bridge: set both values explicitly. The SQLite file
# must already exist in production; the import script creates it privately.
# AFTERIMAGE_STORAGE=sqlite
# AFTERIMAGE_SQLITE_PATH=/Users/agarwalaarush/Projects/AfterImage-hosted/.data/afterimage.sqlite
# On Vercel after the hybrid cutover:
# AFTERIMAGE_STORAGE=macserver
# AFTERIMAGE_BACKEND_URL=https://macserver.example.ts.net
# On both Vercel and the macserver storage bridge, use the same new, independent secret:
# AFTERIMAGE_BACKEND_TOKEN=
# Optional Vercel-only Cloudflare Access Service Auth credentials. Configure both
# together when using the authenticated Cloudflare Tunnel hostname. Never use
# NEXT_PUBLIC_ names or put these in the storage bridge/worker environment.
# AFTERIMAGE_CF_ACCESS_CLIENT_ID=
# AFTERIMAGE_CF_ACCESS_CLIENT_SECRET=
# Optional macserver bridge port (defaults to 3101):
# AFTERIMAGE_BACKEND_PORT=3101
# Worker only
AFTERIMAGE_URL=https://afterimage.aarushagarwal.dev
CODEX_BIN=/usr/local/bin/codex
# Optional: increases the OpenAlex discovery budget.
OPENALEX_API_KEY=
