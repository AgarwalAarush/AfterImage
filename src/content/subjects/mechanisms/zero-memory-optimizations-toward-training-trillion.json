  "beats": [
    {
      "title": "Compute local gradient contributions",
      "explanation": "Each process begins with the full parameter collection containing $p_A$ and $p_B$, while persistent optimizer state remains partitioned as $o_A$ and $o_B$. Different processes run backward propagation and produce current-step contributions $d_A$ and $d_B$. Reduced owner-aligned gradients are still unavailable because the contributions have not yet been combined.",
      "sourceIds": [
        "section-3",
        "section-6"
      ],
      "claimIds": [
        "c1",
        "c3",
        "c4"
      ],
