  "beats": [
    {
      "title": "Training: construct a local pair directly",
      "explanation": "Choose a block Bb and sample σb from its restricted noise distribution, then draw Gaussian ε and construct zb=y+σbε. The condition x and clean target y come from supervised data. This gives the chosen block its input without executing any earlier block: the corruption is sampled directly from y. Training and inference are separate phases in this walkthrough.",
      "sourceIds": [
        "section-3",
        "section-4",
        "supplement-a2",
        "supplement-a3"
      ],
      "claimIds": [
        "c6",
