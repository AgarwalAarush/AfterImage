  "beats": [
    {
      "title": "Define the bounded coarse intervals",
      "explanation": "The ray $\\mathbf r$ and direction $\\mathbf d$ are available. Stratified sampling supplies ordered coarse query depths $t_A,t_B,t_C$ within the bounded ray, while $t_F$ closes the displayed final interval. Thus all required lengths are explicit: $\\delta_A=t_B-t_A$, $\\delta_B=t_C-t_B$, and $\\delta_C=t_F-t_C$. No field predictions or hierarchical draws exist yet.",
      "sourceIds": [
        "section-5"
      ],
      "claimIds": [
        "c7"
      ],
